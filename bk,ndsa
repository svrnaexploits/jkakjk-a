local function UpdateColor(hue)
	currentHue = hue
	MainFrame.BackgroundColor3 = Color3.fromHSV(hue, 1, 0.08)
	TopBar.BackgroundColor3 = Color3.fromHSV(hue, 1, 0.16)
	TopBarCover.BackgroundColor3 = Color3.fromHSV(hue, 1, 0.16)
	MinimizeButton.BackgroundColor3 = Color3.fromHSV(hue, 1, 0.28)
	local baseColor = Color3.fromHSV(hue, 1, 0.2)
	if not PointsToggle then BtnPoints.BackgroundColor3 = baseColor end
	BtnServerHop.BackgroundColor3 = baseColor
end

local function getInput()
	return UserInputService:GetMouseLocation()
end

local resizeStartMouse = Vector2.new()
local resizeStartSize = Vector2.new()

ResizeHandle.MouseButton1Down:Connect(function()
	resizing = true
	MainFrame.Draggable = false
	resizeStartMouse = getInput()
	resizeStartSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)
end)

ResizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		MainFrame.Draggable = false
		resizeStartMouse = Vector2.new(input.Position.X, input.Position.Y)
		resizeStartSize = Vector2.new(MainFrame.AbsoluteSize.X, MainFrame.AbsoluteSize.Y)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if resizing then
			resizing = false
			MainFrame.Draggable = true
		end
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if resizing and input.UserInputType == Enum.UserInputType.Touch then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStartMouse
		local newW = math.max(MIN_W, resizeStartSize.X + delta.X)
		local newH = math.max(MIN_H, resizeStartSize.Y + delta.Y)
		MainFrame.Size = UDim2.new(0, newW, 0, newH)
	end
end)

MinimizeButton.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	if isMinimized then
		ButtonContainer.Visible = false
		SliderFrame.Visible = false
		ResizeHandle.Visible = false
		MainFrame.Size = UDim2.new(0, MainFrame.AbsoluteSize.X, 0, 50)
		TopBarCover.Visible = false
		MinimizeButton.Text = "+"
	else
		ButtonContainer.Visible = true
		SliderFrame.Visible = true
		ResizeHandle.Visible = true
		MainFrame.Size = UDim2.new(0, MainFrame.AbsoluteSize.X, 0, BASE_H)
		TopBarCover.Visible = true
		MinimizeButton.Text = "–"
	end
end)

SliderKnob.MouseButton1Down:Connect(function()
	dragging = true
end)

RunService.RenderStepped:Connect(function()
	if dragging then
		local mousePos = UserInputService:GetMouseLocation().X
		local sliderPos = SliderBar.AbsolutePosition.X
		local sliderSize = SliderBar.AbsoluteSize.X
		local rel = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
		SliderKnob.Position = UDim2.new(rel, -10, 0.5, -10)
		UpdateColor(rel)
	end
	if resizing then
		local mouseNow = getInput()
		local delta = mouseNow - resizeStartMouse
		local newW = math.max(MIN_W, resizeStartSize.X + delta.X)
		local newH = math.max(MIN_H, resizeStartSize.Y + delta.Y)
		if not isMinimized then
			MainFrame.Size = UDim2.new(0, newW, 0, newH)
		end
	end
end)

