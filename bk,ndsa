local function checkStaff(u)
	if u ~= LocalPlayer then
		if game.CreatorType == Enum.CreatorType.Group then
			if u:GetRankInGroup(game.CreatorId) > 20 then
				LocalPlayer:Kick("Staff member detected: " .. u.Name)
			end
		elseif u.UserId == game.CreatorId then
			LocalPlayer:Kick("Creator detected: " .. u.Name)
		end
	end
end
for _, u in ipairs(Players:GetPlayers()) do
	checkStaff(u)
end
Players.PlayerAdded:Connect(checkStaff)

